# ==================================================
# AI MODEL CONFIGURATION (NVIDIA NIM / OPENAI-COMPATIBLE)
# ==================================================
# AI_API_KEY: Your API key for NVIDIA NIM or any OpenAI-compatible provider
AI_API_KEY=""

# AI_BASE_URL: The OpenAI-compatible API Base URL (e.g. NVIDIA NIM API)
# Default for NVIDIA NIM: https://integrate.api.nvidia.com/v1
AI_BASE_URL="https://integrate.api.nvidia.com/v1"

# AI_MODEL: The model identifier (e.g. z-ai/glm-5.3-flash)
AI_MODEL="z-ai/glm-5.3-flash"

# Optional fallback if using Google Gemini
GEMINI_API_KEY=""

# ==================================================
# SUPABASE DATABASE & AUTHENTICATION
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""
